    "format:back": "yarn workspace @training-programs/back format",
    "format:quality": "yarn workspace @training-programs/quality format",
    "format:check": "yarn workspace @training-programs/front format:check && yarn workspace @training-programs/back format:check && yarn workspace @training-programs/quality format:check",
